{
  "name": "rockheal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,mdc,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,mdc,yml,yaml}\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test:mp": "node scripts/multiplayer-smoke.mjs"
  },
  "dependencies": {
    "blit386": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@blit386/kit": "^1.7.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
